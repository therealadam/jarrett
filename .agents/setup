#!/usr/bin/env bash
# Installs Hugo (extended) for previewing the theme with `hugo server`.
set -euo pipefail

HUGO_VERSION="0.117.0"
bin_dir="$HOME/.local/bin"

if [ "$("$bin_dir/hugo" version 2>/dev/null | grep -o 'v[0-9.]*' | head -1)" != "v$HUGO_VERSION" ]; then
  echo "==> Installing Hugo $HUGO_VERSION"
  tmp="$(mktemp -d)"
  trap 'rm -rf "$tmp"' EXIT
  curl -fsSL --retry 3 -o "$tmp/hugo.tar.gz" \
    "https://github.com/gohugoio/hugo/releases/download/v${HUGO_VERSION}/hugo_extended_${HUGO_VERSION}_linux-amd64.tar.gz"
  tar -xzf "$tmp/hugo.tar.gz" -C "$tmp" hugo
  mkdir -p "$bin_dir"
  install -m 0755 "$tmp/hugo" "$bin_dir/hugo"
fi

# Make hugo available in non-interactive login shells.
marker="# jarrett: ~/.local/bin on PATH"
if ! grep -Fqx "$marker" "$HOME/.bash_profile" 2>/dev/null; then
  printf '\n%s\nexport PATH="$HOME/.local/bin:$PATH"\n' "$marker" >> "$HOME/.bash_profile"
fi

"$bin_dir/hugo" version
